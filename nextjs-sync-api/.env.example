# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# On Railway, this is provided automatically as DATABASE_URL when you
# attach a Postgres database to the service.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Authentication ────────────────────────────────────────────────────────────
# Shared secret between this API and trade_sync.py.
# Must match API_SECRET in your Python .env file.
# Generate a strong value: python -c "import secrets; print(secrets.token_hex(32))"
SYNC_API_SECRET="replace-with-a-strong-random-secret"
