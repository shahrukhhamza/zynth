// Prisma schema — Zynth Sync API
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trade {
  id        Int      @id @default(autoincrement())

  // MT5 ticket ID — unique deduplication key (BigInt: MT5 tickets exceed Int range)
  ticketId  BigInt   @unique @map("ticket_id")

  symbol    String
  profit    Decimal  @db.Decimal(12, 2)
  volume    Decimal  @db.Decimal(10, 5)

  entryTime DateTime @map("entry_time")
  exitTime  DateTime @map("exit_time")

  // Server-side audit timestamp
  syncedAt  DateTime @default(now()) @map("synced_at")

  @@map("trades")
}
