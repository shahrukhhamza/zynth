# Polygon.io API Configuration
POLYGON_API_KEY=your_polygon_api_key_here
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# File storage path. For Railway persistent volume use: /data/uploads
# Leave unset for local default: server/uploads
UPLOADS_DIR=

# ── DigitalOcean Spaces (RECOMMENDED — persistent S3-compatible object storage) ──
# Use your $200 DO credits: cloud.digitalocean.com → Spaces → Create Space
# Then: API → Spaces Keys → Generate New Key
# Cost: ~$5/month for 250 GB + outbound CDN — covers ~40 months with $200 credits.
#
# NOTE: Names intentionally avoid _KEY/_SECRET suffixes — those trigger Railpack
# to treat them as Docker build secrets, which causes build failures.
#
# Add these in Railway → Variables:
#   DO_SPACES_ACCESS   = <your-spaces-access-key>
#   DO_SPACES_PASS     = <your-spaces-secret-key>
#   DO_SPACES_ENDPOINT = https://nyc3.digitaloceanspaces.com
#   DO_SPACES_BUCKET   = zynth-uploads
#   DO_SPACES_CDN      = (optional Edge CDN URL from Space settings)
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=zynth-uploads
DO_SPACES_CDN=
DO_SPACES_REGION=us-east-1

# ── Cloudinary (alternative — only used if DO_SPACES_* vars are NOT set) ─────
# Optional: Cloudinary object storage for durable avatars and journal screenshots
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATARS_FOLDER=zynth/avatars
CLOUDINARY_JOURNAL_FOLDER=zynth/journal

# Your Railway deployment URL
# e.g. https://ai-dashboard-production-c844.up.railway.app
RAILWAY_STATIC_URL=

# Launch promotion: every account gets the Elite plan free. Set to false to end it
# (accounts then fall back to the plan they actually paid for; no data migration needed).
PROMO_ELITE_FREE=true
# How many of the earliest signups get the free Elite plan (number, or 'unlimited' for everyone)
PROMO_ELITE_LIMIT=100

# ── Supabase (database + file storage; free tier) ────────────────────────────
# DATABASE_URL: Supabase → Project Settings → Database → Connection string → "Session pooler".
#   Looks like postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   (do NOT use the direct db.<ref>.supabase.co host: it is IPv6-only and fails on most hosts)
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: Project Settings → API. Keep the service-role key secret.
#   Two buckets (zynth-media public, zynth-private private) are created automatically on first start.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: override connection pool size (default 8) and bucket names
# DB_POOL_MAX=8
# SUPABASE_BUCKET=zynth-media
# SUPABASE_PRIVATE_BUCKET=zynth-private
