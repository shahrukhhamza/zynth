# Polygon.io API Configuration
POLYGON_API_KEY=your_polygon_api_key_here
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# File storage path. For Railway persistent volume use: /data/uploads
# Leave unset for local default: server/uploads
UPLOADS_DIR=

# ── DigitalOcean Spaces (RECOMMENDED — persistent S3-compatible object storage) ──
# Use your $200 DO credits: cloud.digitalocean.com → Spaces → Create Space
# Then: API → Spaces Keys → Generate New Key
# Cost: ~$5/month for 250 GB + outbound CDN — covers ~40 months with $200 credits.
#
# Required (all 4 must be set to activate Spaces):
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com   # change region if needed (nyc3 / sfo3 / ams3 / sgp1 / fra1 / blr1)
DO_SPACES_BUCKET=zynth-uploads                           # must match your Space name exactly
# Optional: CDN URL for faster worldwide delivery (copy Edge URL from Space settings)
DO_SPACES_CDN=
DO_SPACES_REGION=us-east-1                               # always us-east-1 for Spaces regardless of actual region

# ── Cloudinary (alternative — only used if DO_SPACES_* vars are NOT set) ─────
# Optional: Cloudinary object storage for durable avatars and journal screenshots
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATARS_FOLDER=zynth/avatars
CLOUDINARY_JOURNAL_FOLDER=zynth/journal

# ── MetaApi (MT4/MT5 cloud sync) ─────────────────────────────────────────────
# Get your token from https://app.metaapi.cloud → API access tokens
METAAPI_TOKEN=

# Shared secret for MetaApi → your webhook endpoint.
# Set this same value in your MetaApi webhook configuration.
METAAPI_WEBHOOK_SECRET=

# Your Railway deployment URL (used to auto-register webhook callbacks)
# e.g. https://ai-dashboard-production-c844.up.railway.app
RAILWAY_STATIC_URL=
