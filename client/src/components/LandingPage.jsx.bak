// ─── Social Proof Bar ────────────────────────────────────────────────────────
function SocialProofBar({ isDark }) {
  const stats = [
    { value: '2,400+', label: 'Active users' },
    { value: '98,000+', label: 'Trades logged' },
    { value: '4.9 ★', label: 'Average rating' },
    { value: '60s', label: 'Setup time' },
  ];
  return (
    <section className="py-12 px-6 border-y" style={{
      borderColor: isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.07)',
      background: isDark ? 'rgba(255,255,255,0.02)' : 'rgba(0,0,0,0.015)',
    }}>
      <div className="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
        <p className={`text-[12px] font-semibold tracking-widest uppercase shrink-0 ${isDark ? 'text-gray-600' : 'text-gray-400'}`}>
          Trusted by traders worldwide
        </p>
        <div className="flex flex-wrap justify-center sm:justify-end gap-x-10 gap-y-4">
          {stats.map(s => (
            <div key={s.label} className="text-center">
              <div className={`text-[22px] font-black tracking-tight ${isDark ? 'text-white' : 'text-gray-900'}`}>{s.value}</div>
              <div className={`text-[11px] mt-0.5 ${isDark ? 'text-gray-600' : 'text-gray-400'}`}>{s.label}</div>
