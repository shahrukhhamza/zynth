import React, { useState, useEffect, useRef } from 'react';
import { ArrowRight, Shield, Zap, Bot, Globe, TrendingUp, Play, Activity, BarChart2, Brain } from 'lucide-react';
import { motion, useMotionValue, useTransform, animate } from 'framer-motion';
import { useTheme } from '../contexts/ThemeContext';

// ─── Dashboard Mockup ────────────────────────────────────────────────────────
function HeroDashboardMockup({ isDark }) {
  const BARS = [42, 65, 38, 71, 55, 80, 67];
  const INSIGHTS = [
    { icon: '⚠', color: '#ef4444', bg: 'rgba(239,68,68,0.08)', border: 'rgba(239,68,68,0.18)', label: 'Revenge trading detected — 3 trades', value: '-$420' },
    { icon: '✓', color: '#10b981', bg: 'rgba(16,185,129,0.08)', border: 'rgba(16,185,129,0.18)', label: 'Best session: 9–11am window', value: '+67% WR' },
    { icon: '↑', color: '#f59e0b', bg: 'rgba(245,158,11,0.08)', border: 'rgba(245,158,11,0.18)', label: 'Overtrading after losses', value: '+38% freq' },
  ];

  const cardBg      = isDark ? '#111113' : '#ffffff';
  const cardBorder  = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.08)';
  const innerBorder = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.06)';
  const labelColor  = isDark ? '#475569' : '#94a3b8';
  const valueColor  = isDark ? '#f1f5f9' : '#0f172a';
  const barInactive = isDark ? 'rgba(59,130,246,0.22)' : 'rgba(59,130,246,0.15)';
  const dayColor    = isDark ? '#1e293b' : '#cbd5e1';
  const insightText = isDark ? '#d1d5db' : '#374151';

  return (
    <div
      className="relative rounded-2xl overflow-hidden"
      style={{
        background: cardBg,
        border: `1px solid ${cardBorder}`,
        boxShadow: isDark
          ? '0 32px 80px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.04)'
          : '0 20px 60px rgba(0,0,0,0.09), 0 4px 16px rgba(59,130,246,0.07)',
      }}
    >
      {/* Browser Top Bar */}
      <div
        className="flex items-center justify-between px-4 py-2.5 border-b"
        style={{ background: isDark ? '#0c0c0e' : '#f8fafc', borderColor: innerBorder }}
      >
        <div className="flex gap-1.5">
          <div className="w-2.5 h-2.5 rounded-full bg-red-500/60" />
          <div className="w-2.5 h-2.5 rounded-full bg-yellow-500/60" />
          <div className="w-2.5 h-2.5 rounded-full bg-emerald-500/60" />
        </div>
        <div
          className="flex items-center gap-1.5 px-4 py-1 rounded-full text-[10px] font-mono"
          style={{
            background: isDark ? 'rgba(255,255,255,0.04)' : 'rgba(0,0,0,0.04)',
            border: `1px solid ${innerBorder}`,
            color: labelColor,
          }}
        >
          <Globe size={9} /> app.zynth.codes
        </div>
        <div className="w-12" />
      </div>

      {/* Stats Row */}
      <div className="grid grid-cols-3 border-b" style={{ borderColor: innerBorder }}>
        {[
          { label: 'Win Rate',    value: '67%',     delta: '↑ +4%',     color: '#10b981' },
          { label: 'Net P&L',     value: '+$2,847', delta: 'this month', color: '#10b981' },
          { label: 'Consistency', value: '81/100',  delta: '↑ +14pts',   color: '#3b82f6' },
        ].map((s, i) => (
          <div
            key={s.label}
            className="p-3.5"
            style={{ borderRight: i < 2 ? `1px solid ${innerBorder}` : 'none' }}
          >
            <div className="text-[10px] font-medium mb-1" style={{ color: labelColor }}>{s.label}</div>
            <div className="text-[15px] font-bold font-mono" style={{ color: valueColor }}>{s.value}</div>
            <div className="text-[10px] font-semibold mt-0.5" style={{ color: s.color }}>{s.delta}</div>
          </div>
        ))}
      </div>

      {/* Bar Chart */}
      <div className="px-4 pt-3.5 pb-3 border-b" style={{ borderColor: innerBorder }}>
        <div className="flex items-center justify-between mb-2.5">
          <span className="text-[11px] font-semibold" style={{ color: isDark ? '#64748b' : '#94a3b8' }}>
            Weekly Performance
          </span>
          <span
            className="text-[10px] px-2 py-0.5 rounded-full font-semibold"
            style={{ background: 'rgba(16,185,129,0.1)', color: '#10b981' }}
          >
            +12.4%
          </span>
        </div>
        <div className="flex items-end gap-1.5 h-12">
          {BARS.map((h, i) => (
            <div
              key={i}
              className="flex-1 rounded-sm"
              style={{
                height: `${h}%`,
                background: i === 5
                  ? 'linear-gradient(to top, #2563eb, #06b6d4)'
                  : barInactive,
              }}
            />
          ))}
        </div>
        <div className="flex justify-between mt-1.5">
          {['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((d, i) => (
            <span key={i} className="flex-1 text-center text-[9px]" style={{ color: dayColor }}>{d}</span>
          ))}
        </div>
      </div>

      {/* AI Insights */}
      <div className="p-4">
        <div className="flex items-center gap-2 mb-3">
          <Bot size={11} style={{ color: '#3b82f6' }} />
          <span className="text-[10px] font-bold uppercase tracking-wider" style={{ color: labelColor }}>
            AI Insights
          </span>
          <span
            className="ml-auto text-[9px] px-1.5 py-0.5 rounded-full font-bold"
            style={{ background: 'rgba(59,130,246,0.1)', color: '#3b82f6', border: '1px solid rgba(59,130,246,0.2)' }}
          >
            LIVE
          </span>
        </div>
        <div className="space-y-1.5">
          {INSIGHTS.map((item) => (
            <div
              key={item.label}
              className="flex items-center gap-2.5 rounded-lg px-3 py-2"
              style={{ background: item.bg, border: `1px solid ${item.border}` }}
            >
              <span className="text-[12px] shrink-0 w-4 text-center" style={{ color: item.color }}>{item.icon}</span>
              <span className="text-[11px] flex-1 font-medium leading-snug" style={{ color: insightText }}>
                {item.label}
              </span>
              <span className="text-[10px] font-bold font-mono shrink-0" style={{ color: item.color }}>
                {item.value}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

// ─── Hero ────────────────────────────────────────────────────────────────────
export default function Hero({ badgeText, spotsLeft, onGetStarted, onSignIn }) {
  const { isDark } = useTheme();

  return (
    <section
      className={`relative overflow-hidden transition-colors duration-300 ${isDark ? '' : 'bg-[#f8fafc]'}`}
      style={{ padding: '88px 24px 100px' }}
    >
      {/* ── Background layers ── */}
      <div className="absolute inset-0 pointer-events-none">
        {/* Dot grid */}
        <div
          className="absolute inset-0"
          style={{
            opacity: isDark ? 0.035 : 0.04,
            backgroundImage: 'radial-gradient(circle at 1px 1px, rgba(148,163,184,0.9) 1px, transparent 0)',
            backgroundSize: '24px 24px',
          }}
        />
        {/* Top center glow */}
        <div
          className="absolute"
          style={{
            top: '-15%',
            left: '35%',
            width: '750px',
            height: '480px',
            background: isDark
              ? 'radial-gradient(ellipse, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.015) 45%, transparent 70%)'
              : 'radial-gradient(ellipse, rgba(99,102,241,0.07) 0%, rgba(59,130,246,0.04) 45%, transparent 70%)',
            borderRadius: '50%',
          }}
        />
      </div>

      {/* ── Main container ── */}
      <div className="relative z-10 max-w-6xl mx-auto">
        <div className="grid lg:grid-cols-2 gap-12 xl:gap-20 items-center">

          {/* ════════ Left Column ════════ */}
          <div>
            {/* Badge pill */}
            <div
              className="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full mb-7 text-[11px] font-semibold"
              style={{
                background: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.04)',
                border: `1px solid ${isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)'}`,
                color: isDark ? '#a1a1aa' : '#3f3f46',
              }}
            >
              <TrendingUp size={11} />
              AI Trading Analytics
            </div>

            {/* Headline */}
            <h1
              className="font-black leading-[1.08] tracking-tight mb-6"
              style={{
                fontSize: 'clamp(36px, 5vw, 54px)',
                letterSpacing: '-0.025em',
              }}
            >
              <span style={{ color: isDark ? '#f1f5f9' : '#0f172a' }}>
                Track. Analyze.<br />
              </span>
              <span className={`bg-clip-text text-transparent bg-gradient-to-r ${isDark ? 'from-white via-zinc-300 to-zinc-500' : 'from-zinc-800 via-zinc-700 to-zinc-600'}`}>
                Fix Your Trading Mistakes.
              </span>
            </h1>

            {/* Subtext */}
            <p
              className="text-[17px] leading-relaxed mb-9"
              style={{ color: isDark ? '#94a3b8' : '#64748b', maxWidth: '440px' }}
            >
              AI-powered journaling and behavioral insights that turn random trading into consistent performance.
            </p>

            {/* CTA Buttons */}
            <div className="flex flex-wrap items-center gap-3 mb-3">
              <button
                onClick={() => onGetStarted()}
                className={`flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-[15px] transition-all duration-200 hover:-translate-y-px active:scale-[0.98] ${isDark ? 'text-[#09090b]' : 'text-white'}`}
                style={{
                  background: isDark ? 'linear-gradient(135deg, #ffffff 0%, #e4e4e7 100%)' : 'linear-gradient(135deg, #18181b 0%, #27272a 100%)',
                  boxShadow: isDark
                    ? '0 4px 22px rgba(255,255,255,0.12)'
                    : '0 4px 18px rgba(0,0,0,0.2)',
                }}
              >
                Start Free
                <ArrowRight size={16} />
              </button>

              <button
                onClick={() => document.getElementById('features')?.scrollIntoView({ behavior: 'smooth' })}
                className="flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-[15px] transition-all duration-200 hover:-translate-y-px active:scale-[0.98]"
                style={{
                  background: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.04)',
                  border: `1px solid ${isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)'}`,
                  color: isDark ? '#cbd5e1' : '#334155',
                }}
              >
                <Play size={13} style={{ color: isDark ? '#a1a1aa' : '#3f3f46' }} />
                See How It Works
              </button>
            </div>

            {/* No credit card */}
            <p
              className="text-[12px] mb-8"
              style={{ color: isDark ? '#374151' : '#a0aec0' }}
            >
              No credit card required
            </p>

            {/* Trust pills */}
            <div className="flex flex-wrap items-center gap-2">
              {[
                { Icon: Shield, label: 'Encrypted' },
                { Icon: Zap,    label: 'Instant Setup' },
                { Icon: Bot,    label: 'AI by Gemini' },
              ].map(({ Icon, label }) => (
                <div
                  key={label}
                  className="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] font-medium"
                  style={{
                    background: isDark ? 'rgba(255,255,255,0.04)' : '#ffffff',
                    border: `1px solid ${isDark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)'}`,
                    color: isDark ? '#64748b' : '#64748b',
                    boxShadow: isDark ? 'none' : '0 1px 3px rgba(0,0,0,0.05)',
                  }}
                >
                  <Icon size={11} style={{ color: isDark ? '#71717a' : '#52525b' }} />
                  {label}
                </div>
              ))}
            </div>
          </div>

          {/* ════════ Right Column — Mockup ════════ */}
          <div className="relative">
            {/* Glow behind the card */}
            <div
              className="absolute pointer-events-none"
              style={{
                inset: '-10% -5%',
                background: isDark
                  ? 'radial-gradient(ellipse at 60% 50%, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.02) 40%, transparent 70%)'
                  : 'radial-gradient(ellipse at 60% 50%, rgba(59,130,246,0.1) 0%, rgba(99,102,241,0.06) 40%, transparent 70%)',
                filter: 'blur(38px)',
                zIndex: 0,
              }}
            />
            <div className="relative z-10">
              <HeroDashboardMockup isDark={isDark} />
            </div>
          </div>

        </div>
      </div>
    </section>
  );
}